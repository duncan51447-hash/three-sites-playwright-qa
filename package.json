{
  "name": "three-sites-playwright-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Playwright QA for pl168.net, jf1688.com.tw, and firstloan.tw",
  "scripts": {
    "test": "playwright test",
    "prepare:qa": "node scripts/prepare-qa.mjs",
    "test:engine": "playwright test -c playwright.engine.config.ts",
    "typecheck": "tsc --noEmit",
    "test:persistence": "node scripts/check-persistence.mjs",
    "test:collect": "node scripts/check-collection.mjs",
    "test:matrix": "node scripts/check-matrix.mjs",
    "report:qa": "node scripts/report-qa.mjs --gate",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.2"
  }
}
